---
import nebuLogo from "../assets/nebu_logo.svg";
import StarfieldBackground from "../components/StarfieldBackground.astro";
import { nebeeConfig, nebeeFaqItems } from "../data/nebee";

const faqAnswersMap = Object.fromEntries(
  nebeeFaqItems.map((item) => [item.key, item.answerHtml])
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{nebeeConfig.logoAlt}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        try {
          const saved = localStorage.getItem('nebu-theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const theme = saved === 'light' || saved === 'dark' ? saved : (prefersDark ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
        } catch (_) {}
      })();
    </script>
  </head>
  <body>
    <StarfieldBackground enabled={nebeeConfig.enableBackgroundEffect ?? true} />

    <!-- Ukryty formularz statyczny rejestrowany przez Netlify Forms -->
    <form
      name="nebu-lead-capture"
      method="POST"
      action="/"
      data-netlify="true"
      netlify-honeypot="bot-field"
      hidden
    >
      <input type="hidden" name="form-name" value="nebu-lead-capture" />
      <input type="text" name="bot-field" />
      <input type="email" name="email" />
      <textarea name="question"></textarea>
      <textarea name="clickedTopics"></textarea>
    </form>

    <!-- Przycisk przełączania motywu w prawym górnym rogu -->
    <button
      type="button"
      class="theme-toggle"
      id="themeToggle"
      aria-label="Toggle color theme"
      title="Toggle light / dark mode"
    >
      <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
      </svg>
      <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
      </svg>
    </button>

    <div class="page-content" id="pageContent">
      <main class="stage">
        <!-- Brand Header -->
        <header class="brand-header" id="brandHeader">
          <div class="logo-wrapper">
            <img
              src={nebuLogo.src}
              alt={nebeeConfig.logoAlt}
              class="brand-logo"
              loading="eager"
            />
          </div>
          <h1 class="hero-title" set:html={nebeeConfig.heroTitleHtml} />
          <p class="tagline" set:html={nebeeConfig.tagline} />
        </header>

        <!-- Widget Shell -->
        <div class="widget-shell" id="widgetShell">

          <!-- 1. CLOSED STATE: Initial Pill Trigger -->
          <button type="button" class="pill-trigger" id="openChatBtn" aria-expanded="false">
            <span class="avatar-badge" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                <rect x="7" y="8" width="3.5" height="8" rx="1.75" fill="currentColor" />
                <rect x="13.5" y="8" width="3.5" height="8" rx="1.75" fill="currentColor" />
              </svg>
            </span>
            <span class="pill-label">{nebeeConfig.pillLabel}</span>
          </button>

          <!-- 2. OPEN STATE: Full Chat Dialog Box -->
          <section
            class="chat-card"
            id="chatCard"
            aria-label={`Chat with ${nebeeConfig.botName}`}
            hidden
            data-bot-name={nebeeConfig.botName}
            data-cleared-msg={nebeeConfig.clearedMessage}
            data-default-placeholder={nebeeConfig.inputPlaceholder}
            data-email-placeholder={nebeeConfig.emailPlaceholder || "Enter your e-mail..."}
            data-custom-prompt-html={nebeeConfig.customQuestionPromptHtml || `I see you have a specific question and a vision for what you want to build. Drop your e-mail below and wave to us so we can stay in touch — or simply write to <a href="mailto:${nebeeConfig.contactEmail}">${nebeeConfig.contactEmail}</a>.`}
            data-fallback-html={nebeeConfig.defaultFallbackHtml}
            data-submit-html={nebeeConfig.formSubmitReplyHtml}
            data-contact-email={nebeeConfig.contactEmail}
          >
            <!-- Top Header Bar -->
            <div class="chat-header">
              <div class="chat-header-info">
                <span class="avatar-badge">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                    <rect x="7" y="8" width="3.5" height="8" rx="1.75" fill="currentColor" />
                    <rect x="13.5" y="8" width="3.5" height="8" rx="1.75" fill="currentColor" />
                  </svg>
                </span>
                <div class="header-text">
                  <div class="header-title">{nebeeConfig.botName}</div>
                  <div class="header-subtitle">{nebeeConfig.botSubtitle}</div>
                </div>
              </div>
              <div class="header-actions">
                <button type="button" class="action-text-btn" id="clearChatBtn">Clear</button>
                <button type="button" class="close-btn" id="closeChatBtn" aria-label="Close window">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round" />
                  </svg>
                </button>
              </div>
            </div>

            <!-- Messages History -->
            <div class="chat-body" id="chatMessages">
              <div class="message-group bot">
                <div class="bubble">{nebeeConfig.welcomeMessage}</div>
                <div class="meta">{nebeeConfig.botName} · AI agent · Just now</div>
              </div>
            </div>

            <!-- FAQ Interactive Chips -->
            <div
              class="quick-prompts"
              id="quickPrompts"
              data-answers={JSON.stringify(faqAnswersMap)}
            >
              {nebeeFaqItems.map((item) => (
                <button type="button" class="chip" data-key={item.key} data-label={item.label}>
                  {item.label}
                </button>
              ))}
            </div>

            <!-- Bottom Input Pill -->
            <div class="chat-footer">
              <div class="input-row" id="inputRow">
                <form
                  name="nebu-leads"
                  method="POST"
                  action="/"
                  data-netlify="true"
                  class="input-pill"
                  id="leadForm"
                >
                  <input type="hidden" name="form-name" value="nebu-leads" />
                  <input
                    type="text"
                    name="message"
                    id="userInput"
                    placeholder={nebeeConfig.inputPlaceholder}
                    required
                    autocomplete="off"
                  />
                  <button type="submit" class="send-btn" id="sendBtn" aria-label="Send message">
                    <svg class="send-arrow" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <path d="M12 19V5M5 12l7-7 7 7" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <span class="wave-send-content" aria-hidden="true">
                      <svg class="wave-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 11V6a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v0"></path>
                        <path d="M14 10V4a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v2"></path>
                        <path d="M10 10.5V6a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v8"></path>
                        <path d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15"></path>
                      </svg>
                      <span>Send</span>
                    </span>
                  </button>
                </form>

                <button
                  type="button"
                  class="cancel-email-btn"
                  id="cancelEmailBtn"
                  aria-label="Cancel email step and return to question"
                  title="Back to question"
                  hidden
                >
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
                    <path d="M18 6L6 18M6 6l12 12" />
                  </svg>
                </button>
              </div>

              <div class="privacy-note">
                {nebeeConfig.botName} answers from nebu.studio.{" "}
                <button type="button" class="privacy-link-btn" id="openPrivacyBtn">
                  Privacy policy
                </button>
              </div>
            </div>
          </section>
        </div>
      </main>
    </div>

    <!-- Popup / Modal Polityki Prywatności -->
    <div
      class="privacy-backdrop"
      id="privacyBackdrop"
      role="dialog"
      aria-modal="true"
      aria-labelledby="privacyModalTitle"
      hidden
    >
      <section class="privacy-modal" id="privacyModal">
        <div class="chat-header">
          <div class="chat-header-info">
            <div class="header-text">
              <div class="header-title" id="privacyModalTitle">Privacy Policy</div>
              <div class="header-subtitle">nebu.studio · Last updated: 20.11.26</div>
            </div>
          </div>
          <div class="header-actions">
            <button type="button" class="close-btn" id="closePrivacyBtn" aria-label="Close privacy policy">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round" />
              </svg>
            </button>
          </div>
        </div>

        <div class="privacy-modal-body">
          <h3>1. Introduction</h3>
          <p>
            This Privacy Policy outlines how <strong>nebu.studio</strong> ("we", "us", or "our") gathers, uses, cares for, and discloses information from visitors and users ("you" or "users") of the nebu.studio website ("Site"). It applies to the Site and every digital product, design service, and resource provided by nebu.studio.
          </p>

          <h3>2. Personal Identification Information</h3>
          <p>
            You are welcome to explore the Site anonymously. We only collect personal details when you choose to share them—for instance, when you submit a project inquiry, leave your e-mail address in the assistant, ask for a quote, sign up for updates, or place an order. Depending on the interaction, this may include your name, e-mail address, company details, billing or delivery information, or message content. You can always decline to provide optional details, though doing so may prevent certain requests or services from being completed.
          </p>

          <h3>3. Non-Personal Identification Information</h3>
          <p>
            Whenever you interact with the Site, non-identifying technical data may be recorded automatically, such as your browser version, device type, operating system, screen resolution, referring page, and basic network/connection details required to deliver the Site properly.
          </p>

          <h3>4. How We Use Collected Information</h3>
          <p>nebu.studio may use information you share for the following purposes:</p>
          <ul>
            <li><strong>Customer &amp; project support:</strong> Responding to inquiries, questions, and scope discussions clearly and promptly;</li>
            <li><strong>Experience &amp; product improvement:</strong> Understanding how visitors use the Site so we can refine layouts, content, and workflows;</li>
            <li><strong>Orders &amp; payments:</strong> Processing transactions and delivering requested work solely to fulfill what you ordered;</li>
            <li><strong>Direct communication:</strong> Replying to your messages or sending occasional updates when you opt in (with easy opt-out options at any time).</li>
          </ul>

          <h3>5. How We Protect Your Information</h3>
          <p>
            We follow sensible technical and organizational practices to protect personal and inquiry data handled via the Site against unauthorized access, alteration, loss, or disclosure. While we take care to protect your data, no method of online transmission or storage can be guaranteed completely secure.
          </p>

          <h3>6. Sharing Your Personal Information</h3>
          <p>
            We do not sell, trade, or rent users' personal identification information to third parties. We may share aggregated, anonymous usage statistics with partners, or work with trusted service providers (such as hosting, form handling, or communication tools) strictly as needed to operate the Site and respond to your requests under confidentiality obligations.
          </p>

          <h3>7. Cookies</h3>
          <p>
            The Site keeps small pieces of data in your browser needed for core functionality, such as your selected theme and cookie preferences. Optional analytics cookies (Google Analytics, Microsoft Clarity) or marketing cookies (Google Ads, Meta, X, Apollo) are only used when permitted. Aggregate visit counting via privacy-focused tools (such as Plausible and Ahrefs Web Analytics) does not set tracking cookies or identify you individually. When you submit a form or book a call, session context—such as pages visited, buttons clicked, time on site, device type, and approximate location (city and country)—may accompany the inquiry to help us understand what you looked for. Prior to submission, this context stays in your current browser tab and is cleared when you close the tab. You can review or adjust your choice anytime via cookie settings, and preferences are remembered for 6 months.
          </p>

          <h3>8. Changes to This Privacy Policy</h3>
          <p>
            nebu.studio may update this Privacy Policy periodically as the Site and services evolve. Whenever we make changes, we will update the "Last updated" date above. Checking this page occasionally is the best way to stay informed about how we handle information.
          </p>
        </div>
      </section>
    </div>

    <script is:inline>
      const themeToggle = document.getElementById('themeToggle');
      const systemDarkQuery = window.matchMedia('(prefers-color-scheme: dark)');

      function applyTheme(theme, persist = false) {
        document.documentElement.setAttribute('data-theme', theme);
        if (persist) {
          try {
            localStorage.setItem('nebu-theme', theme);
          } catch (_) {}
        }
        window.dispatchEvent(new CustomEvent('nebu-theme-change', { detail: { theme } }));
      }

      if (themeToggle) {
        themeToggle.addEventListener('click', () => {
          const current = document.documentElement.getAttribute('data-theme') ||
            (systemDarkQuery.matches ? 'dark' : 'light');
          const next = current === 'dark' ? 'light' : 'dark';
          applyTheme(next, true);
        });
      }

      systemDarkQuery.addEventListener('change', (e) => {
        let saved = null;
        try {
          saved = localStorage.getItem('nebu-theme');
        } catch (_) {}
        if (!saved) {
          applyTheme(e.matches ? 'dark' : 'light', false);
        }
      });

      // Privacy Policy modal
      const openPrivacyBtn = document.getElementById('openPrivacyBtn');
      const closePrivacyBtn = document.getElementById('closePrivacyBtn');
      const privacyBackdrop = document.getElementById('privacyBackdrop');

      function openPrivacyModal() {
        if (!privacyBackdrop) return;
        privacyBackdrop.hidden = false;
        document.body.style.overflow = 'hidden';
        if (closePrivacyBtn) closePrivacyBtn.focus();
      }

      function closePrivacyModal() {
        if (!privacyBackdrop) return;
        privacyBackdrop.hidden = true;
        document.body.style.overflow = '';
        if (openPrivacyBtn) openPrivacyBtn.focus();
      }

      if (openPrivacyBtn) openPrivacyBtn.addEventListener('click', openPrivacyModal);
      if (closePrivacyBtn) closePrivacyBtn.addEventListener('click', closePrivacyModal);
      if (privacyBackdrop) {
        privacyBackdrop.addEventListener('click', (e) => {
          if (e.target === privacyBackdrop) {
            closePrivacyModal();
          }
        });
      }
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && privacyBackdrop && !privacyBackdrop.hidden) {
          closePrivacyModal();
        }
      });

      // Logika widżetu czatu Nebee + przechwytywanie leada
      const shell = document.getElementById('widgetShell');
      const openBtn = document.getElementById('openChatBtn');
      const closeBtn = document.getElementById('closeChatBtn');
      const clearBtn = document.getElementById('clearChatBtn');
      const chatCard = document.getElementById('chatCard');
      const brandHeader = document.getElementById('brandHeader');
      const stage = document.querySelector('.stage');
      const form = document.getElementById('leadForm');
      const input = document.getElementById('userInput');
      const cancelEmailBtn = document.getElementById('cancelEmailBtn');
      const messages = document.getElementById('chatMessages');
      const quickPromptsEl = document.getElementById('quickPrompts');
      const chips = document.querySelectorAll('.chip');

      const botName = chatCard ? chatCard.getAttribute('data-bot-name') || 'Nebee' : 'Nebee';
      const clearedMsg = chatCard ? chatCard.getAttribute('data-cleared-msg') || 'Chat cleared.' : 'Chat cleared.';
      const defaultPlaceholder = chatCard ? chatCard.getAttribute('data-default-placeholder') || 'Ask a question...' : 'Ask a question...';
      const emailPlaceholder = chatCard ? chatCard.getAttribute('data-email-placeholder') || 'Enter your e-mail...' : 'Enter your e-mail...';
      const customPromptHtml = chatCard ? chatCard.getAttribute('data-custom-prompt-html') || '' : '';
      const fallbackHtml = chatCard ? chatCard.getAttribute('data-fallback-html') || '' : '';
      const submitHtml = chatCard ? chatCard.getAttribute('data-submit-html') || '' : '';
      const contactEmail = chatCard ? chatCard.getAttribute('data-contact-email') || 'hi@nebu.studio' : 'hi@nebu.studio';

      let faqAnswers = {};
      if (quickPromptsEl && quickPromptsEl.dataset.answers) {
        try {
          faqAnswers = JSON.parse(quickPromptsEl.dataset.answers);
        } catch (_) {}
      }

      let clickedTopics = [];
      let pendingCustomQuestion = null;
      let awaitingEmail = false;
      let closeChatTimer = null;

      function exitEmailMode(focusInput = true) {
        awaitingEmail = false;
        pendingCustomQuestion = null;
        if (form) form.classList.remove('is-email-mode');
        if (cancelEmailBtn) cancelEmailBtn.hidden = true;
        if (input) {
          input.type = 'text';
          input.placeholder = defaultPlaceholder;
          input.value = '';
          if (focusInput) input.focus();
        }
      }

      function enterEmailMode(customQuestionText) {
        awaitingEmail = true;
        pendingCustomQuestion = customQuestionText;
        if (form) form.classList.add('is-email-mode');
        if (cancelEmailBtn) cancelEmailBtn.hidden = false;
        if (input) {
          input.type = 'email';
          input.placeholder = emailPlaceholder;
          input.value = '';
          input.focus();
        }
      }

      function openChat() {
        if (!shell || !openBtn || !chatCard || !stage) return;
        if (closeChatTimer) {
          clearTimeout(closeChatTimer);
          closeChatTimer = null;
        }
        if (brandHeader) {
          brandHeader.style.transform = '';
        }
        openBtn.setAttribute('aria-expanded', 'true');
        openBtn.style.display = 'none';
        stage.classList.add('chat-is-open');
        chatCard.hidden = false;
        requestAnimationFrame(() => {
          chatCard.classList.add('is-visible');
          if (input) input.focus();
        });
      }

      function closeChat() {
        if (!shell || !openBtn || !chatCard || !stage) return;
        if (closeChatTimer) {
          clearTimeout(closeChatTimer);
          closeChatTimer = null;
        }

        // Zapamiętujemy aktualną pozycję nagłówka, żeby zniknięcie wysokiego chatCard nie „zrzuciło” go w dół
        let headerTopBefore = 0;
        if (brandHeader) {
          headerTopBefore = brandHeader.getBoundingClientRect().top;
        }

        openBtn.setAttribute('aria-expanded', 'false');
        chatCard.classList.remove('is-visible');
        stage.classList.remove('chat-is-open');

        closeChatTimer = setTimeout(() => {
          chatCard.hidden = true;
          openBtn.style.display = 'inline-flex';

          if (brandHeader) {
            const headerTopAfter = brandHeader.getBoundingClientRect().top;
            const deltaY = headerTopBefore - headerTopAfter;
            if (Math.abs(deltaY) > 0.5) {
              brandHeader.style.transition = 'none';
              brandHeader.style.transform = `translate3d(0, ${deltaY}px, 0)`;
              void brandHeader.offsetHeight;
              brandHeader.style.transition = 'transform 0.45s cubic-bezier(0.22, 1, 0.36, 1)';
              brandHeader.style.transform = 'translate3d(0, 0, 0)';
            }
          }

          closeChatTimer = null;
        }, 220);
      }

      function clearChat() {
        clickedTopics = [];
        exitEmailMode(false);
        if (!messages) return;
        messages.innerHTML = `
          <div class="message-group bot">
            <div class="bubble">${clearedMsg}</div>
            <div class="meta">${botName} · AI agent · Just now</div>
          </div>
        `;
      }

      if (openBtn) openBtn.addEventListener('click', openChat);
      if (closeBtn) closeBtn.addEventListener('click', closeChat);
      if (clearBtn) clearBtn.addEventListener('click', clearChat);
      if (cancelEmailBtn) {
        cancelEmailBtn.addEventListener('click', () => {
          exitEmailMode(true);
        });
      }

      function appendMessage(text, sender, isHtml = false) {
        if (!messages) return;
        const group = document.createElement('div');
        group.className = 'message-group ' + sender;

        const bubble = document.createElement('div');
        bubble.className = 'bubble';
        if (isHtml) {
          bubble.innerHTML = text;
        } else {
          bubble.textContent = text;
        }

        const meta = document.createElement('div');
        meta.className = 'meta';
        meta.textContent = sender === 'user' ? 'You · Just now' : `${botName} · AI agent · Just now`;

        group.appendChild(bubble);
        group.appendChild(meta);
        messages.appendChild(group);
        messages.scrollTop = messages.scrollHeight;
      }

      async function simulateTypingAndAnswer(answerHtml) {
        if (!messages) return;

        const typingGroup = document.createElement('div');
        typingGroup.className = 'message-group bot typing-indicator-group';
        typingGroup.innerHTML = `
          <div class="bubble typing-bubble">
            <span class="dot-pulse"></span>
            <span class="dot-pulse"></span>
            <span class="dot-pulse"></span>
          </div>
        `;
        messages.appendChild(typingGroup);
        messages.scrollTop = messages.scrollHeight;

        await new Promise((r) => setTimeout(r, 650));
        typingGroup.remove();

        appendMessage(answerHtml, 'bot', true);
      }

      async function sendSummaryToNetlify(userEmail, customQuestion, topicsList) {
        const topicsSummary = topicsList.length > 0
          ? topicsList.join(', ')
          : 'No topics clicked before question';

        const payload = new URLSearchParams();
        payload.append('form-name', 'nebu-lead-capture');
        payload.append('email', userEmail);
        payload.append('question', customQuestion || '');
        payload.append('clickedTopics', topicsSummary);

        try {
          await fetch('/', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: payload.toString(),
          });
        } catch (_) {}
      }

      if (form) {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          if (!input) return;
          const val = input.value.trim();
          if (!val) return;
          input.value = '';

          if (awaitingEmail) {
            const savedQuestion = pendingCustomQuestion;
            const savedTopics = [...clickedTopics];

            appendMessage(val, 'user');
            exitEmailMode(false);

            await sendSummaryToNetlify(val, savedQuestion, savedTopics);

            const topicsBadge = savedTopics.length > 0
              ? `<br><br><span style="opacity:0.75;font-size:0.84em;">Summary sent to <strong>${contactEmail}</strong> (clicked topics: ${savedTopics.join(', ')}).</span>`
              : `<br><br><span style="opacity:0.75;font-size:0.84em;">Summary sent to <strong>${contactEmail}</strong>.</span>`;

            await simulateTypingAndAnswer(`${submitHtml}${topicsBadge}`);
            return;
          }

          appendMessage(val, 'user');
          enterEmailMode(val);
          await simulateTypingAndAnswer(customPromptHtml);
          if (input) input.focus();
        });
      }

      chips.forEach((chip) => {
        chip.addEventListener('click', async () => {
          const key = chip.getAttribute('data-key');
          const label = chip.getAttribute('data-label') || (chip.textContent ? chip.textContent.trim() : '');

          if (label && !clickedTopics.includes(label)) {
            clickedTopics.push(label);
          }

          appendMessage(label, 'user');

          const answer = key && faqAnswers[key] ? faqAnswers[key] : fallbackHtml;
          await simulateTypingAndAnswer(answer);
        });
      });
    </script>

    <style is:global>
      :root,
      :root[data-theme="light"] {
        --bg: #fafafa;
        --surface: #ffffff;
        --surface-subtle: #f3f4f6;
        --border: rgba(0, 0, 0, 0.08);
        --border-strong: rgba(0, 0, 0, 0.15);
        --text: #0f172a;
        --text-muted: #64748b;
        --badge-bg: #0b131e;
        --badge-fg: #ffffff;
        --tech-blue-300: #99c0ff;
        --tech-blue: #0062FF;
        --tech-blue-700: #003b99;
        --user-bubble: var(--tech-blue-300);
        --user-fg: #001f52;
        --danger: #dc2626;
        --danger-hover: #b91c1c;
        --shadow-pill: 0 4px 20px rgba(0, 0, 0, 0.05), 0 1px 3px rgba(0, 0, 0, 0.04);
        --shadow-card: 0 24px 60px -12px rgba(0, 0, 0, 0.12), 0 4px 16px rgba(0, 0, 0, 0.04);
        --scrollbar-thumb: rgba(0, 0, 0, 0.18);
        --link-color: #0062FF;
        --logo-height: 28px;
        --logo-filter: brightness(0) saturate(100%) invert(6%) sepia(15%) saturate(1800%) hue-rotate(185deg) brightness(95%) contrast(96%);
        color-scheme: light;
      }

      :root[data-theme="dark"] {
        --bg: #0a0a0b;
        --surface: #131316;
        --surface-subtle: #1e1e23;
        --border: rgba(255, 255, 255, 0.09);
        --border-strong: rgba(255, 255, 255, 0.16);
        --text: #f4f4f5;
        --text-muted: #9ca3af;
        --badge-bg: #f4f4f5;
        --badge-fg: #0a0a0b;
        --user-bubble: var(--tech-blue-700);
        --user-fg: #ffffff;
        --danger: #ef4444;
        --danger-hover: #dc2626;
        --shadow-pill: 0 4px 20px rgba(0, 0, 0, 0.4);
        --shadow-card: 0 24px 60px -12px rgba(0, 0, 0, 0.65);
        --scrollbar-thumb: rgba(255, 255, 255, 0.22);
        --link-color: #66a1ff;
        --logo-filter: none;
        color-scheme: dark;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      .chat-body::-webkit-scrollbar,
      .privacy-modal-body::-webkit-scrollbar {
        width: 5px;
      }
      .chat-body::-webkit-scrollbar-track,
      .privacy-modal-body::-webkit-scrollbar-track {
        background: transparent;
      }
      .chat-body::-webkit-scrollbar-thumb,
      .privacy-modal-body::-webkit-scrollbar-thumb {
        background: var(--scrollbar-thumb);
        border-radius: 999px;
      }

      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        background-color: var(--bg);
        color: var(--text);
        min-height: 100dvh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        -webkit-font-smoothing: antialiased;
        transition: background-color 0.45s ease, color 0.45s ease;
      }

      body::after {
        content: "";
        position: fixed;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background: radial-gradient(
          circle at 50% 50%,
          transparent 62%,
          color-mix(in srgb, var(--bg) 16%, transparent) 100%
        );
        transition: background 0.45s ease;
      }

      .page-content {
        position: relative;
        z-index: 1;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .theme-toggle {
        position: fixed;
        top: 22px;
        right: 22px;
        z-index: 10;
        width: 38px;
        height: 38px;
        border-radius: 999px;
        background: var(--surface);
        border: 1px solid var(--border);
        color: var(--text-muted);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        box-shadow: var(--shadow-pill);
        transition: color 0.2s ease, border-color 0.2s ease, transform 0.2s ease, background-color 0.35s ease;
      }

      .theme-toggle:hover {
        color: var(--text);
        border-color: var(--border-strong);
        transform: translateY(-1px);
      }

      .theme-toggle svg {
        transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
      }

      .theme-toggle:hover svg {
        transform: rotate(18deg);
      }

      :root[data-theme="light"] .icon-sun,
      :root:not([data-theme]) .icon-sun {
        display: none;
      }

      :root[data-theme="dark"] .icon-moon {
        display: none;
      }

      /* Łagodny, płynny powrót do środka bez efektu ciężkiego opadania */
      .stage {
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: 740px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 28px;
        transform: translate3d(0, 0, 0);
        transition: transform 0.42s cubic-bezier(0.25, 0.8, 0.25, 1);
      }

      .stage.chat-is-open {
        transform: translate3d(0, -16px, 0);
      }

      .brand-header {
        text-align: center;
        max-width: 720px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 32px;
        will-change: transform;
      }

      .logo-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .brand-logo {
        height: var(--logo-height);
        width: auto;
        display: block;
        filter: var(--logo-filter);
        transition: filter 0.3s ease;
      }

      .hero-title {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        font-weight: 700;
        font-size: clamp(2.35rem, 5.8vw, 58px);
        line-height: 1.1;
        letter-spacing: -0.03em;
        color: var(--text);
      }

      .tagline {
        margin-top: -16px;
        max-width: 540px;
        font-size: 0.95rem;
        line-height: 1.65;
        color: var(--text-muted);
      }

      .widget-shell {
        width: 100%;
        max-width: 620px;
        display: flex;
        justify-content: center;
      }

      .pill-trigger {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        padding: 10px 20px 10px 12px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 999px;
        color: var(--text);
        font-family: inherit;
        font-size: 0.95rem;
        font-weight: 500;
        cursor: pointer;
        box-shadow: var(--shadow-pill);
        transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1),
                    box-shadow 0.2s ease,
                    border-color 0.2s ease,
                    background-color 0.35s ease;
      }

      .pill-trigger:hover {
        transform: translateY(-2px);
        border-color: var(--border-strong);
        box-shadow: 0 8px 28px rgba(0, 0, 0, 0.08);
      }

      .avatar-badge {
        width: 32px;
        height: 32px;
        border-radius: 10px;
        background: var(--badge-bg);
        color: var(--badge-fg);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        transition: background-color 0.35s ease, color 0.35s ease;
      }

      .chat-card {
        width: 100%;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 20px;
        box-shadow: var(--shadow-card);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        opacity: 0;
        transform: translate3d(0, 10px, 0) scale(0.985);
        transition: opacity 0.22s ease,
                    transform 0.22s cubic-bezier(0.25, 0.8, 0.25, 1),
                    background-color 0.35s ease;
      }

      .chat-card[hidden] {
        display: none;
      }

      .chat-card.is-visible {
        opacity: 1;
        transform: translate3d(0, 0, 0) scale(1);
      }

      .chat-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 18px;
        border-bottom: 1px solid var(--border);
        flex-shrink: 0;
      }

      .chat-header-info {
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .header-title {
        font-size: 0.92rem;
        font-weight: 600;
        line-height: 1.2;
      }

      .header-subtitle {
        font-size: 0.77rem;
        color: var(--text-muted);
        margin-top: 2px;
      }

      .header-actions {
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .action-text-btn {
        background: transparent;
        border: none;
        color: var(--text-muted);
        font-family: inherit;
        font-size: 0.84rem;
        font-weight: 500;
        padding: 6px 10px;
        border-radius: 6px;
        cursor: pointer;
        transition: background 0.15s ease, color 0.15s ease;
      }

      .action-text-btn:hover {
        background: var(--surface-subtle);
        color: var(--text);
      }

      .close-btn {
        background: transparent;
        border: none;
        color: var(--text-muted);
        width: 30px;
        height: 30px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: background 0.15s ease, color 0.15s ease;
      }

      .close-btn:hover {
        background: var(--surface-subtle);
        color: var(--text);
      }

      .chat-body {
        padding: 20px 18px;
        min-height: 200px;
        max-height: 300px;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 16px;
      }

      .message-group {
        display: flex;
        flex-direction: column;
        max-width: 85%;
        animation: fadeInMsg 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      }

      @keyframes fadeInMsg {
        from { opacity: 0; transform: translateY(6px); }
        to { opacity: 1; transform: translateY(0); }
      }

      .message-group.bot {
        align-self: flex-start;
      }

      .message-group.user {
        align-self: flex-end;
      }

      .bubble {
        padding: 14px 18px;
        border-radius: 16px;
        font-size: 0.91rem;
        line-height: 1.65;
      }

      .bubble a {
        color: var(--link-color);
        text-decoration: underline;
        text-underline-offset: 2px;
      }

      .message-group.bot .bubble {
        background: var(--surface-subtle);
        color: var(--text);
        border: 1px solid var(--border);
        border-bottom-left-radius: 4px;
      }

      .message-group.user .bubble {
        background: var(--user-bubble);
        color: var(--user-fg);
        border-bottom-right-radius: 4px;
      }

      .meta {
        font-size: 0.72rem;
        color: var(--text-muted);
        margin-top: 6px;
        padding-left: 4px;
      }

      .message-group.user .meta {
        align-self: flex-end;
        padding-right: 4px;
      }

      .typing-bubble {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 15px 18px !important;
      }

      .dot-pulse {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--text-muted);
        animation: pulseDot 1.2s infinite ease-in-out both;
      }

      .dot-pulse:nth-child(2) { animation-delay: 0.2s; }
      .dot-pulse:nth-child(3) { animation-delay: 0.4s; }

      @keyframes pulseDot {
        0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
        40% { transform: scale(1); opacity: 1; }
      }

      .quick-prompts {
        display: flex;
        gap: 8px;
        padding: 12px 18px 12px;
        border-top: 1px solid var(--border);
        overflow-x: auto;
        scrollbar-width: none;
        -ms-overflow-style: none;
      }

      .quick-prompts::-webkit-scrollbar {
        display: none;
      }

      .chip {
        flex-shrink: 0;
        padding: 7px 14px;
        border-radius: 999px;
        background: var(--surface);
        border: 1px solid var(--border);
        color: var(--text);
        font-family: inherit;
        font-size: 0.82rem;
        font-weight: 500;
        cursor: pointer;
        transition: background 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
      }

      .chip:hover {
        background: var(--surface-subtle);
        border-color: var(--border-strong);
        transform: translateY(-2px);
      }

      .chat-footer {
        padding: 0 18px 16px;
        display: flex;
        flex-direction: column;
        gap: 10px;
      }

      .input-row {
        display: flex;
        align-items: center;
        width: 100%;
        gap: 0;
      }

      .input-pill {
        flex: 1;
        min-width: 0;
        display: flex;
        align-items: center;
        background: var(--surface);
        border: 1px solid var(--border-strong);
        border-radius: 999px;
        padding: 5px 5px 5px 16px;
        box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.03);
        transition: border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.25s ease;
      }

      .input-pill:focus-within {
        border-color: var(--text);
        box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.02), 0 0 0 3px rgba(0, 98, 255, 0.12);
      }

      .input-pill input {
        flex: 1;
        min-width: 0;
        border: none;
        background: transparent;
        color: var(--text);
        font-family: inherit;
        font-size: 0.9rem;
        outline: none;
      }

      .input-pill input::placeholder {
        color: var(--text-muted);
      }

      .send-btn {
        height: 34px;
        min-width: 34px;
        border-radius: 999px;
        border: none;
        background: var(--badge-bg);
        color: var(--badge-fg);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 0 10px;
        font-family: inherit;
        font-size: 0.82rem;
        font-weight: 600;
        cursor: pointer;
        flex-shrink: 0;
        transition: transform 0.15s ease, opacity 0.15s ease, background-color 0.25s ease, color 0.25s ease;
      }

      .send-btn:hover {
        opacity: 0.88;
        transform: scale(1.03);
      }

      .wave-send-content {
        display: none;
        align-items: center;
        gap: 6px;
      }

      .input-row:has(.cancel-email-btn:not([hidden])) {
        gap: 8px;
      }

      .input-pill.is-email-mode,
      .input-pill.is-email-mode:focus-within {
        background: var(--tech-blue);
        border: 1px solid var(--tech-blue-700);
        box-shadow: none;
        outline: none;
      }

      .input-pill.is-email-mode input {
        color: #ffffff;
        outline: none;
      }

      .input-pill.is-email-mode input::placeholder {
        color: rgba(255, 255, 255, 0.85);
      }

      .input-pill.is-email-mode .send-btn {
        background: #ffffff;
        color: var(--tech-blue);
        padding: 0 13px;
      }

      .input-pill.is-email-mode .send-arrow {
        display: none;
      }

      .input-pill.is-email-mode .wave-send-content {
        display: inline-flex;
      }

      .input-pill.is-email-mode:hover .wave-icon {
        animation: waveHand 0.75s ease-in-out infinite;
        transform-origin: 70% 80%;
      }

      @keyframes waveHand {
        0%, 100% { transform: rotate(0deg); }
        25% { transform: rotate(18deg); }
        50% { transform: rotate(-12deg); }
        75% { transform: rotate(15deg); }
      }

      .cancel-email-btn {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        border: none;
        background: var(--danger);
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        flex-shrink: 0;
        transition: background-color 0.2s ease, transform 0.15s ease;
      }

      .cancel-email-btn[hidden] {
        display: none;
      }

      .cancel-email-btn:hover {
        background: var(--danger-hover);
        transform: scale(1.05);
      }

      .privacy-note {
        text-align: center;
        font-size: 0.73rem;
        color: var(--text-muted);
      }

      .privacy-link-btn {
        background: none;
        border: none;
        padding: 0;
        font: inherit;
        color: var(--link-color);
        text-decoration: underline;
        text-underline-offset: 2px;
        cursor: pointer;
      }

      .privacy-link-btn:hover {
        opacity: 0.85;
      }

      .privacy-backdrop {
        position: fixed;
        inset: 0;
        z-index: 50;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: rgba(10, 10, 11, 0.72);
      }

      .privacy-backdrop[hidden] {
        display: none;
      }

      .privacy-modal {
        width: 100%;
        max-width: 640px;
        max-height: min(84dvh, 720px);
        background: var(--surface);
        border: 1px solid var(--border-strong);
        border-radius: 20px;
        box-shadow: var(--shadow-card);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        opacity: 1;
        transform: none;
      }

      .privacy-modal-body {
        padding: 20px 22px;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 10px;
        font-size: 0.86rem;
        line-height: 1.65;
        color: var(--text);
      }

      .privacy-modal-body h3 {
        font-size: 0.9rem;
        font-weight: 600;
        margin-top: 6px;
        color: var(--text);
      }

      .privacy-modal-body h3:first-child {
        margin-top: 0;
      }

      .privacy-modal-body p,
      .privacy-modal-body ul {
        color: var(--text-muted);
      }

      .privacy-modal-body ul {
        padding-left: 18px;
        display: flex;
        flex-direction: column;
        gap: 4px;
      }
    </style>
  </body>
</html>