---
import nebuLogo from "../assets/nebu_logo.svg";
import BaseLayout from "../layouts/BaseLayout.astro";
import ChatWidget from "../components/ChatWidget.astro";
import PrivacyModal from "../components/PrivacyModal.astro";
import { nebeeConfig, nebeeFaqItems } from "../data/nebee";
---

<BaseLayout
  title={nebeeConfig.logoAlt}
  enableBackgroundEffect={nebeeConfig.enableBackgroundEffect ?? true}
>
  <main class="stage">
    <header class="brand-header" id="brandHeader">
      <div class="logo-wrapper">
        <img
          src={nebuLogo.src}
          alt={nebeeConfig.logoAlt}
          class="brand-logo"
          loading="eager"
        />
      </div>
      <h1 class="hero-title" set:html={nebeeConfig.heroTitleHtml} />
      <p class="tagline" set:html={nebeeConfig.tagline} />
    </header>

    <ChatWidget
      botName={nebeeConfig.botName}
      botSubtitle={nebeeConfig.botSubtitle}
      pillLabel={nebeeConfig.pillLabel}
      welcomeMessage={nebeeConfig.welcomeMessage}
      clearedMessage={nebeeConfig.clearedMessage}
      inputPlaceholder={nebeeConfig.inputPlaceholder}
      emailPlaceholder={nebeeConfig.emailPlaceholder}
      customQuestionPromptHtml={nebeeConfig.customQuestionPromptHtml}
      defaultFallbackHtml={nebeeConfig.defaultFallbackHtml}
      formSubmitReplyHtml={nebeeConfig.formSubmitReplyHtml}
      contactEmail={nebeeConfig.contactEmail}
      faqItems={nebeeFaqItems}
    />
  </main>

  <PrivacyModal />
</BaseLayout>