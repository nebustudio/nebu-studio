---
import nebuLogo from "../assets/nebu_logo.svg";
import StarfieldBackground from "../components/StarfieldBackground.astro";
import { nebeeConfig, nebeeFaqItems } from "../data/nebee";

const faqAnswersMap = Object.fromEntries(
  nebeeFaqItems.map((item) => [item.key, item.answerHtml])
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{nebeeConfig.logoAlt}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        try {
          const saved = localStorage.getItem('nebu-theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const theme = saved === 'light' || saved === 'dark' ? saved : (prefersDark ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
        } catch (_) {}
      })();
    </script>
  </head>
  <body>
    <StarfieldBackground enabled={nebeeConfig.enableBackgroundEffect ?? true} />

    <!-- Ukryty formularz statyczny dla bota Netlify Forms -->
    <form name="nebu-lead-capture" method="POST" data-netlify="true" hidden>
      <input type="text" name="email" />
      <textarea name="question"></textarea>
      <textarea name="clickedTopics"></textarea>
    </form>

    <!-- Przycisk przełączania motywu w prawym górnym rogu -->
    <button
      type="button"
      class="theme-toggle"
      id="themeToggle"
      aria-label="Toggle color theme"
      title="Toggle light / dark mode"
    >
      <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
      </svg>
      <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
      </svg>
    </button>

    <main class="stage">
      <!-- Brand Header -->
      <header class="brand-header">
        <div class="logo-wrapper">
          <img
            src={nebuLogo.src}
            alt={nebeeConfig.logoAlt}
            class="brand-logo"
            loading="eager"
          />
        </div>
        <p class="tagline">{nebeeConfig.tagline}</p>
      </header>

      <!-- Widget Shell -->
      <div class="widget-shell" id="widgetShell">

        <!-- 1. CLOSED STATE: Initial Pill Trigger -->
        <button type="button" class="pill-trigger" id="openChatBtn" aria-expanded="false">
          <span class="avatar-badge" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
              <rect x="7" y="8" width="3.5" height="8" rx="1.75" fill="currentColor" />
              <rect x="13.5" y="8" width="3.5" height="8" rx="1.75" fill="currentColor" />
            </svg>
          </span>
          <span class="pill-label">{nebeeConfig.pillLabel}</span>
        </button>

        <!-- 2. OPEN STATE: Full Chat Dialog Box -->
        <section
          class="chat-card"
          id="chatCard"
          aria-label={`Chat with ${nebeeConfig.botName}`}
          hidden
          data-bot-name={nebeeConfig.botName}
          data-cleared-msg={nebeeConfig.clearedMessage}
          data-default-placeholder={nebeeConfig.inputPlaceholder}
          data-email-placeholder={nebeeConfig.emailPlaceholder || "Enter your e-mail..."}
          data-custom-prompt-html={nebeeConfig.customQuestionPromptHtml || `I see you have a specific question and a vision for what you want to build. Drop your e-mail below and wave to us so we can stay in touch — or simply write to <a href="mailto:${nebeeConfig.contactEmail}">${nebeeConfig.contactEmail}</a>.`}
          data-fallback-html={nebeeConfig.defaultFallbackHtml}
          data-submit-html={nebeeConfig.formSubmitReplyHtml}
          data-contact-email={nebeeConfig.contactEmail}
        >
          <!-- Top Header Bar -->
          <div class="chat-header">
            <div class="chat-header-info">
              <span class="avatar-badge">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                  <rect x="7" y="8" width="3.5" height="8" rx="1.75" fill="currentColor" />
                  <rect x="13.5" y="8" width="3.5" height="8" rx="1.75" fill="currentColor" />
                </svg>
              </span>
              <div class="header-text">
                <div class="header-title">{nebeeConfig.botName}</div>
                <div class="header-subtitle">{nebeeConfig.botSubtitle}</div>
              </div>
            </div>
            <div class="header-actions">
              <button type="button" class="action-text-btn" id="clearChatBtn">Clear</button>
              <button type="button" class="close-btn" id="closeChatBtn" aria-label="Close window">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round" />
                </svg>
              </button>
            </div>
          </div>

          <!-- Messages History -->
          <div class="chat-body" id="chatMessages">
            <div class="message-group bot">
              <div class="bubble">{nebeeConfig.welcomeMessage}</div>
              <div class="meta">{nebeeConfig.botName} · AI agent · Just now</div>
            </div>
          </div>

          <!-- FAQ Interactive Chips -->
          <div
            class="quick-prompts"
            id="quickPrompts"
            data-answers={JSON.stringify(faqAnswersMap)}
          >
            {nebeeFaqItems.map((item) => (
              <button type="button" class="chip" data-key={item.key} data-label={item.label}>
                {item.label}
              </button>
            ))}
          </div>

          <!-- Bottom Input Pill -->
          <div class="chat-footer">
            <div class="input-row" id="inputRow">
              <form
                name="nebu-leads"
                method="POST"
                data-netlify="true"
                class="input-pill"
                id="leadForm"
              >
                <input type="hidden" name="form-name" value="nebu-leads" />
                <input
                  type="text"
                  name="message"
                  id="userInput"
                  placeholder={nebeeConfig.inputPlaceholder}
                  required
                  autocomplete="off"
                />
                <button type="submit" class="send-btn" id="sendBtn" aria-label="Send message">
                  <!-- Strzałka w trybie standardowym -->
                  <svg class="send-arrow" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M12 19V5M5 12l7-7 7 7" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <!-- Machająca dłoń + "Send" w trybie podawania e-maila -->
                  <span class="wave-send-content" aria-hidden="true">
                    <svg class="wave-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M18 11V6a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v0"></path>
                      <path d="M14 10V4a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v2"></path>
                      <path d="M10 10.5V6a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v8"></path>
                      <path d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15"></path>
                    </svg>
                    <span>Send</span>
                  </span>
                </button>
              </form>

              <!-- Czerwone kółko 34x34 z krzyżykiem w tym samym miejscu, co wcześniej strzałka -->
              <button
                type="button"
                class="cancel-email-btn"
                id="cancelEmailBtn"
                aria-label="Cancel email step and return to question"
                title="Back to question"
                hidden
              >
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
                  <path d="M18 6L6 18M6 6l12 12" />
                </svg>
              </button>
            </div>

            <div class="privacy-note">
              {nebeeConfig.botName} answers from{" "}
              <a href={`mailto:${nebeeConfig.contactEmail}`}>{nebeeConfig.contactEmail}</a>.{" "}
              <a href={`mailto:${nebeeConfig.contactEmail}`}>Privacy policy</a>
            </div>
          </div>
        </section>
      </div>
    </main>

    <script is:inline>
      const themeToggle = document.getElementById('themeToggle');
      const systemDarkQuery = window.matchMedia('(prefers-color-scheme: dark)');

      function applyTheme(theme, persist = false) {
        document.documentElement.setAttribute('data-theme', theme);
        if (persist) {
          try {
            localStorage.setItem('nebu-theme', theme);
          } catch (_) {}
        }
        window.dispatchEvent(new CustomEvent('nebu-theme-change', { detail: { theme } }));
      }

      if (themeToggle) {
        themeToggle.addEventListener('click', () => {
          const current = document.documentElement.getAttribute('data-theme') ||
            (systemDarkQuery.matches ? 'dark' : 'light');
          const next = current === 'dark' ? 'light' : 'dark';
          applyTheme(next, true);
        });
      }

      systemDarkQuery.addEventListener('change', (e) => {
        let saved = null;
        try {
          saved = localStorage.getItem('nebu-theme');
        } catch (_) {}
        if (!saved) {
          applyTheme(e.matches ? 'dark' : 'light', false);
        }
      });

      const shell = document.getElementById('widgetShell');
      const openBtn = document.getElementById('openChatBtn');
      const closeBtn = document.getElementById('closeChatBtn');
      const clearBtn = document.getElementById('clearChatBtn');
      const chatCard = document.getElementById('chatCard');
      const stage = document.querySelector('.stage');
      const form = document.getElementById('leadForm');
      const input = document.getElementById('userInput');
      const cancelEmailBtn = document.getElementById('cancelEmailBtn');
      const messages = document.getElementById('chatMessages');
      const quickPromptsEl = document.getElementById('quickPrompts');
      const chips = document.querySelectorAll('.chip');

      const botName = chatCard ? chatCard.getAttribute('data-bot-name') || 'Nebee' : 'Nebee';
      const clearedMsg = chatCard ? chatCard.getAttribute('data-cleared-msg') || 'Chat cleared.' : 'Chat cleared.';
      const defaultPlaceholder = chatCard ? chatCard.getAttribute('data-default-placeholder') || 'Ask a question...' : 'Ask a question...';
      const emailPlaceholder = chatCard ? chatCard.getAttribute('data-email-placeholder') || 'Enter your e-mail...' : 'Enter your e-mail...';
      const customPromptHtml = chatCard ? chatCard.getAttribute('data-custom-prompt-html') || '' : '';
      const fallbackHtml = chatCard ? chatCard.getAttribute('data-fallback-html') || '' : '';
      const submitHtml = chatCard ? chatCard.getAttribute('data-submit-html') || '' : '';
      const contactEmail = chatCard ? chatCard.getAttribute('data-contact-email') || 'hi@nebu.studio' : 'hi@nebu.studio';

      let faqAnswers = {};
      if (quickPromptsEl && quickPromptsEl.dataset.answers) {
        try {
          faqAnswers = JSON.parse(quickPromptsEl.dataset.answers);
        } catch (_) {}
      }

      let clickedTopics = [];
      let pendingCustomQuestion = null;
      let awaitingEmail = false;

      function exitEmailMode(focusInput = true) {
        awaitingEmail = false;
        pendingCustomQuestion = null;
        if (form) form.classList.remove('is-email-mode');
        if (cancelEmailBtn) cancelEmailBtn.hidden = true;
        if (input) {
          input.type = 'text';
          input.placeholder = defaultPlaceholder;
          input.value = '';
          if (focusInput) input.focus();
        }
      }

      function enterEmailMode(customQuestionText) {
        awaitingEmail = true;
        pendingCustomQuestion = customQuestionText;
        if (form) form.classList.add('is-email-mode');
        if (cancelEmailBtn) cancelEmailBtn.hidden = false;
        if (input) {
          input.type = 'email';
          input.placeholder = emailPlaceholder;
          input.value = '';
          input.focus();
        }
      }

      function openChat() {
        if (!shell || !openBtn || !chatCard || !stage) return;
        openBtn.style.display = 'none';
        stage.classList.add('chat-is-open');
        chatCard.hidden = false;
        requestAnimationFrame(() => {
          chatCard.classList.add('is-visible');
          if (input) input.focus();
        });
      }

      function closeChat() {
        if (!shell || !openBtn || !chatCard || !stage) return;
        chatCard.classList.remove('is-visible');
        stage.classList.remove('chat-is-open');
        setTimeout(() => {
          chatCard.hidden = true;
          openBtn.style.display = 'inline-flex';
        }, 300);
      }

      function clearChat() {
        clickedTopics = [];
        exitEmailMode(false);
        if (!messages) return;
        messages.innerHTML = `
          <div class="message-group bot">
            <div class="bubble">${clearedMsg}</div>
            <div class="meta">${botName} · AI agent · Just now</div>
          </div>
        `;
      }

      if (openBtn) openBtn.addEventListener('click', openChat);
      if (closeBtn) closeBtn.addEventListener('click', closeChat);
      if (clearBtn) clearBtn.addEventListener('click', clearChat);
      if (cancelEmailBtn) {
        cancelEmailBtn.addEventListener('click', () => {
          exitEmailMode(true);
        });
      }

      function appendMessage(text, sender, isHtml = false) {
        if (!messages) return;
        const group = document.createElement('div');
        group.className = 'message-group ' + sender;

        const bubble = document.createElement('div');
        bubble.className = 'bubble';
        if (isHtml) {
          bubble.innerHTML = text;
        } else {
          bubble.textContent = text;
        }

        const meta = document.createElement('div');
        meta.className = 'meta';
        meta.textContent = sender === 'user' ? 'You · Just now' : `${botName} · AI agent · Just now`;

        group.appendChild(bubble);
        group.appendChild(meta);
        messages.appendChild(group);
        messages.scrollTop = messages.scrollHeight;
      }

      async function simulateTypingAndAnswer(answerHtml) {
        if (!messages) return;

        const typingGroup = document.createElement('div');
        typingGroup.className = 'message-group bot typing-indicator-group';
        typingGroup.innerHTML = `
          <div class="bubble typing-bubble">
            <span class="dot-pulse"></span>
            <span class="dot-pulse"></span>
            <span class="dot-pulse"></span>
          </div>
        `;
        messages.appendChild(typingGroup);
        messages.scrollTop = messages.scrollHeight;

        await new Promise((r) => setTimeout(r, 650));
        typingGroup.remove();

        appendMessage(answerHtml, 'bot', true);
      }

      async function sendSummaryToNetlify(userEmail, customQuestion, topicsList) {
        const topicsSummary = topicsList.length > 0
          ? topicsList.join(', ')
          : 'No topics clicked before question';

        const payload = new URLSearchParams();
        payload.append('form-name', 'nebu-lead-capture');
        payload.append('email', userEmail);
        payload.append('question', customQuestion || '');
        payload.append('clickedTopics', topicsSummary);

        try {
          await fetch('/', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: payload.toString(),
          });
        } catch (_) {}
      }

      if (form) {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          if (!input) return;
          const val = input.value.trim();
          if (!val) return;
          input.value = '';

          if (awaitingEmail) {
            const savedQuestion = pendingCustomQuestion;
            const savedTopics = [...clickedTopics];

            appendMessage(val, 'user');
            exitEmailMode(false);

            await sendSummaryToNetlify(val, savedQuestion, savedTopics);

            const topicsBadge = savedTopics.length > 0
              ? `<br><br><span style="opacity:0.75;font-size:0.84em;">Summary sent to <strong>${contactEmail}</strong> (clicked topics: ${savedTopics.join(', ')}).</span>`
              : `<br><br><span style="opacity:0.75;font-size:0.84em;">Summary sent to <strong>${contactEmail}</strong>.</span>`;

            await simulateTypingAndAnswer(`${submitHtml}${topicsBadge}`);
            return;
          }

          appendMessage(val, 'user');
          enterEmailMode(val);
          await simulateTypingAndAnswer(customPromptHtml);
          if (input) input.focus();
        });
      }

      chips.forEach((chip) => {
        chip.addEventListener('click', async () => {
          const key = chip.getAttribute('data-key');
          const label = chip.getAttribute('data-label') || (chip.textContent ? chip.textContent.trim() : '');

          if (label && !clickedTopics.includes(label)) {
            clickedTopics.push(label);
          }

          appendMessage(label, 'user');

          const answer = key && faqAnswers[key] ? faqAnswers[key] : fallbackHtml;
          await simulateTypingAndAnswer(answer);
        });
      });
    </script>

    <style is:global>
      :root,
      :root[data-theme="light"] {
        --bg: #fafafa;
        --surface: #ffffff;
        --surface-subtle: #f3f4f6;
        --border: rgba(0, 0, 0, 0.08);
        --border-strong: rgba(0, 0, 0, 0.15);
        --text: #0f172a;
        --text-muted: #64748b;
        --badge-bg: #0b131e;
        --badge-fg: #ffffff;
        /* Błękit waga ~300 dla motywu jasnego */
        --user-bubble: #7dd3fc;
        --user-fg: #082f49;
        --tech-blue: #0284c7;
        --tech-blue-border-700: #0369a1;
        --danger: #dc2626;
        --danger-hover: #b91c1c;
        --shadow-pill: 0 4px 20px rgba(0, 0, 0, 0.05), 0 1px 3px rgba(0, 0, 0, 0.04);
        --shadow-card: 0 24px 60px -12px rgba(0, 0, 0, 0.12), 0 4px 16px rgba(0, 0, 0, 0.04);
        --scrollbar-thumb: rgba(0, 0, 0, 0.18);
        --link-color: #0369a1;
        --logo-height: 56px;
        --logo-filter: brightness(0) saturate(100%) invert(6%) sepia(15%) saturate(1800%) hue-rotate(185deg) brightness(95%) contrast(96%);
        color-scheme: light;
      }

      :root[data-theme="dark"] {
        --bg: #0a0a0b;
        --surface: #131316;
        --surface-subtle: #1e1e23;
        --border: rgba(255, 255, 255, 0.09);
        --border-strong: rgba(255, 255, 255, 0.16);
        --text: #f4f4f5;
        --text-muted: #9ca3af;
        --badge-bg: #f4f4f5;
        --badge-fg: #0a0a0b;
        /* Błękit waga ~700 dla motywu ciemnego */
        --user-bubble: #0369a1;
        --user-fg: #ffffff;
        --tech-blue: #0284c7;
        --tech-blue-border-700: #0369a1;
        --danger: #ef4444;
        --danger-hover: #dc2626;
        --shadow-pill: 0 4px 20px rgba(0, 0, 0, 0.4);
        --shadow-card: 0 24px 60px -12px rgba(0, 0, 0, 0.65);
        --scrollbar-thumb: rgba(255, 255, 255, 0.22);
        --link-color: #38bdf8;
        --logo-filter: none;
        color-scheme: dark;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      .chat-body::-webkit-scrollbar {
        width: 5px;
      }
      .chat-body::-webkit-scrollbar-track {
        background: transparent;
      }
      .chat-body::-webkit-scrollbar-thumb {
        background: var(--scrollbar-thumb);
        border-radius: 999px;
      }

      body {
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
        background-color: var(--bg);
        color: var(--text);
        min-height: 100dvh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        -webkit-font-smoothing: antialiased;
        transition: background-color 0.35s ease, color 0.35s ease;
      }

      body::after {
        content: "";
        position: fixed;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background: radial-gradient(
          ellipse 78% 72% at 50% 50%,
          transparent 45%,
          color-mix(in srgb, var(--bg) 55%, transparent) 78%,
          var(--bg) 100%
        );
        transition: background 0.35s ease;
      }

      .theme-toggle {
        position: fixed;
        top: 22px;
        right: 22px;
        z-index: 10;
        width: 38px;
        height: 38px;
        border-radius: 999px;
        background: var(--surface);
        border: 1px solid var(--border);
        color: var(--text-muted);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        box-shadow: var(--shadow-pill);
        transition: color 0.2s ease, border-color 0.2s ease, transform 0.2s ease, background-color 0.35s ease;
      }

      .theme-toggle:hover {
        color: var(--text);
        border-color: var(--border-strong);
        transform: translateY(-1px);
      }

      .theme-toggle svg {
        transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
      }

      .theme-toggle:hover svg {
        transform: rotate(18deg);
      }

      :root[data-theme="light"] .icon-sun,
      :root:not([data-theme]) .icon-sun {
        display: none;
      }

      :root[data-theme="dark"] .icon-moon {
        display: none;
      }

      .stage {
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: 620px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 28px;
        transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      }

      .stage.chat-is-open {
        transform: translateY(-16px);
      }

      .brand-header {
        text-align: center;
        max-width: 460px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 14px;
        transition: opacity 0.3s ease;
      }

      .logo-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .brand-logo {
        height: var(--logo-height);
        width: auto;
        display: block;
        filter: var(--logo-filter);
        transition: filter 0.3s ease;
      }

      .tagline {
        font-size: 0.95rem;
        line-height: 1.6;
        color: var(--text-muted);
      }

      .widget-shell {
        width: 100%;
        display: flex;
        justify-content: center;
      }

      .pill-trigger {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        padding: 10px 20px 10px 12px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 999px;
        color: var(--text);
        font-family: inherit;
        font-size: 0.95rem;
        font-weight: 500;
        cursor: pointer;
        box-shadow: var(--shadow-pill);
        transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1),
                    box-shadow 0.2s ease,
                    border-color 0.2s ease,
                    background-color 0.35s ease;
      }

      .pill-trigger:hover {
        transform: translateY(-2px);
        border-color: var(--border-strong);
        box-shadow: 0 8px 28px rgba(0, 0, 0, 0.08);
      }

      .avatar-badge {
        width: 32px;
        height: 32px;
        border-radius: 10px;
        background: var(--badge-bg);
        color: var(--badge-fg);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        transition: background-color 0.35s ease, color 0.35s ease;
      }

      .chat-card {
        width: 100%;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 20px;
        box-shadow: var(--shadow-card);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        opacity: 0;
        transform: translateY(12px) scale(0.98);
        transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                    transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                    background-color 0.35s ease;
      }

      .chat-card[hidden] {
        display: none;
      }

      .chat-card.is-visible {
        opacity: 1;
        transform: translateY(0) scale(1);
      }

      .chat-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 18px;
        border-bottom: 1px solid var(--border);
      }

      .chat-header-info {
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .header-title {
        font-size: 0.92rem;
        font-weight: 600;
        line-height: 1.2;
      }

      .header-subtitle {
        font-size: 0.77rem;
        color: var(--text-muted);
        margin-top: 2px;
      }

      .header-actions {
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .action-text-btn {
        background: transparent;
        border: none;
        color: var(--text-muted);
        font-family: inherit;
        font-size: 0.84rem;
        font-weight: 500;
        padding: 6px 10px;
        border-radius: 6px;
        cursor: pointer;
        transition: background 0.15s ease, color 0.15s ease;
      }

      .action-text-btn:hover {
        background: var(--surface-subtle);
        color: var(--text);
      }

      .close-btn {
        background: transparent;
        border: none;
        color: var(--text-muted);
        width: 30px;
        height: 30px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: background 0.15s ease, color 0.15s ease;
      }

      .close-btn:hover {
        background: var(--surface-subtle);
        color: var(--text);
      }

      .chat-body {
        padding: 20px 18px;
        min-height: 200px;
        max-height: 300px;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 16px;
      }

      .message-group {
        display: flex;
        flex-direction: column;
        max-width: 85%;
        animation: fadeInMsg 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      }

      @keyframes fadeInMsg {
        from { opacity: 0; transform: translateY(6px); }
        to { opacity: 1; transform: translateY(0); }
      }

      .message-group.bot {
        align-self: flex-start;
      }

      .message-group.user {
        align-self: flex-end;
      }

      .bubble {
        padding: 14px 18px;
        border-radius: 16px;
        font-size: 0.91rem;
        line-height: 1.65;
      }

      .bubble a {
        color: var(--link-color);
        text-decoration: underline;
        text-underline-offset: 2px;
      }

      .message-group.bot .bubble {
        background: var(--surface-subtle);
        color: var(--text);
        border: 1px solid var(--border);
        border-bottom-left-radius: 4px;
      }

      .message-group.user .bubble {
        background: var(--user-bubble);
        color: var(--user-fg);
        border-bottom-right-radius: 4px;
      }

      .meta {
        font-size: 0.72rem;
        color: var(--text-muted);
        margin-top: 6px;
        padding-left: 4px;
      }

      .message-group.user .meta {
        align-self: flex-end;
        padding-right: 4px;
      }

      .typing-bubble {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 15px 18px !important;
      }

      .dot-pulse {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--text-muted);
        animation: pulseDot 1.2s infinite ease-in-out both;
      }

      .dot-pulse:nth-child(2) { animation-delay: 0.2s; }
      .dot-pulse:nth-child(3) { animation-delay: 0.4s; }

      @keyframes pulseDot {
        0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
        40% { transform: scale(1); opacity: 1; }
      }

      .quick-prompts {
        display: flex;
        gap: 8px;
        padding: 12px 18px 12px;
        border-top: 1px solid var(--border);
        overflow-x: auto;
        scrollbar-width: none;
        -ms-overflow-style: none;
      }

      .quick-prompts::-webkit-scrollbar {
        display: none;
      }

      .chip {
        flex-shrink: 0;
        padding: 7px 14px;
        border-radius: 999px;
        background: var(--surface);
        border: 1px solid var(--border);
        color: var(--text);
        font-family: inherit;
        font-size: 0.82rem;
        font-weight: 500;
        cursor: pointer;
        transition: background 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
      }

      .chip:hover {
        background: var(--surface-subtle);
        border-color: var(--border-strong);
        transform: translateY(-2px);
      }

      .chat-footer {
        padding: 0 18px 16px;
        display: flex;
        flex-direction: column;
        gap: 10px;
      }

      .input-row {
        display: flex;
        align-items: center;
        width: 100%;
        gap: 0;
      }

      .input-pill {
        flex: 1;
        min-width: 0;
        display: flex;
        align-items: center;
        background: var(--surface);
        border: 1px solid var(--border-strong);
        border-radius: 999px;
        padding: 5px 5px 5px 16px;
        box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.03);
        transition: border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.25s ease;
      }

      .input-pill:focus-within {
        border-color: var(--text);
        box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.02), 0 0 0 3px rgba(0, 68, 56, 0.12);
      }

      .input-pill input {
        flex: 1;
        min-width: 0;
        border: none;
        background: transparent;
        color: var(--text);
        font-family: inherit;
        font-size: 0.9rem;
        outline: none;
      }

      .input-pill input::placeholder {
        color: var(--text-muted);
      }

      .send-btn {
        height: 34px;
        min-width: 34px;
        border-radius: 999px;
        border: none;
        background: var(--badge-bg);
        color: var(--badge-fg);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 0 10px;
        font-family: inherit;
        font-size: 0.82rem;
        font-weight: 600;
        cursor: pointer;
        flex-shrink: 0;
        transition: transform 0.15s ease, opacity 0.15s ease, background-color 0.25s ease, color 0.25s ease;
      }

      .send-btn:hover {
        opacity: 0.88;
        transform: scale(1.03);
      }

      .wave-send-content {
        display: none;
        align-items: center;
        gap: 6px;
      }

      .input-row:has(.cancel-email-btn:not([hidden])) {
        gap: 8px;
      }

      .input-pill.is-email-mode,
      .input-pill.is-email-mode:focus-within {
        background: var(--tech-blue);
        border: 1px solid var(--tech-blue-border-700);
        box-shadow: none;
      }

      .input-pill.is-email-mode input {
        color: #ffffff;
      }

      .input-pill.is-email-mode input::placeholder {
        color: rgba(255, 255, 255, 0.85);
      }

      .input-pill.is-email-mode .send-btn {
        background: #ffffff;
        color: var(--tech-blue);
        padding: 0 13px;
      }

      .input-pill.is-email-mode .send-arrow {
        display: none;
      }

      .input-pill.is-email-mode .wave-send-content {
        display: inline-flex;
      }

      .input-pill.is-email-mode:hover .wave-icon {
        animation: waveHand 0.75s ease-in-out infinite;
        transform-origin: 70% 80%;
      }

      @keyframes waveHand {
        0%, 100% { transform: rotate(0deg); }
        25% { transform: rotate(18deg); }
        50% { transform: rotate(-12deg); }
        75% { transform: rotate(15deg); }
      }

      .cancel-email-btn {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        border: none;
        background: var(--danger);
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        flex-shrink: 0;
        transition: background-color 0.2s ease, transform 0.15s ease;
      }

      .cancel-email-btn[hidden] {
        display: none;
      }

      .cancel-email-btn:hover {
        background: var(--danger-hover);
        transform: scale(1.05);
      }

      .privacy-note {
        text-align: center;
        font-size: 0.73rem;
        color: var(--text-muted);
      }

      .privacy-note a {
        color: var(--link-color);
        text-decoration: underline;
        text-underline-offset: 2px;
      }
    </style>
  </body>
</html>