---
interface Props {
  enabled?: boolean;
}

const { enabled = true } = Astro.props;
---

{enabled && (
  <canvas id="nebu-starfield" class="nebu-starfield" aria-hidden="true"></canvas>
)}

<script is:inline>
  (function () {
    const canvas = document.getElementById('nebu-starfield');
    if (!canvas) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (reducedMotion.matches) {
      canvas.style.display = 'none';
      return;
    }

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const darkQuery = window.matchMedia('(prefers-color-scheme: dark)');

    function getCurrentIsDark() {
      const explicitTheme = document.documentElement.getAttribute('data-theme');
      if (explicitTheme === 'dark') return true;
      if (explicitTheme === 'light') return false;
      return darkQuery.matches;
    }

    let isDark = getCurrentIsDark();
    let width = 0;
    let height = 0;
    let dpr = 1;

    const mouse = { x: -9999, y: -9999, active: false };

    // Tryb CIEMNY: gwiazdy lecące w stronę widza
    const DARK_COUNT = 110;
    const DARK_SPEED = 0.0022;
    let darkStars = [];

    // Tryb JASNY: miękkie błękitne mgławice (tony 200 / 300) reagujące na ruch kursora
    const NEBULA_COUNT = 7;
    const NEBULA_INFLUENCE_RADIUS = 320;
    const NEBULA_PUSH = 34;
    const NEBULA_EASE = 0.035;
    let nebulae = [];

    function initDarkStars() {
      darkStars = [];
      for (let i = 0; i < DARK_COUNT; i++) {
        darkStars.push({
          x: (Math.random() - 0.5) * width * 1.6,
          y: (Math.random() - 0.5) * height * 1.6,
          z: Math.random(),
          size: 0.7 + Math.random() * 1.1,
        });
      }
    }

    function initNebulae() {
      nebulae = [];
      const minDim = Math.max(width, height, 600);
      const palette = [
        { rgb: '186, 230, 253', alpha: 0.42 }, // ~200
        { rgb: '125, 211, 252', alpha: 0.30 }, // ~300
      ];

      for (let i = 0; i < NEBULA_COUNT; i++) {
        const angle = (i / NEBULA_COUNT) * Math.PI * 2 + (Math.random() - 0.5) * 0.45;
        const distFactor = 0.16 + Math.random() * 0.28;
        const bx = width * 0.5 + Math.cos(angle) * width * distFactor;
        const by = height * 0.5 + Math.sin(angle) * height * distFactor;
        const tone = palette[i % palette.length];
        const radius = minDim * (0.24 + Math.random() * 0.14);

        nebulae.push({
          baseX: bx,
          baseY: by,
          x: bx,
          y: by,
          radius,
          rgb: tone.rgb,
          alpha: tone.alpha,
          driftPhase: Math.random() * Math.PI * 2,
          driftSpeed: 0.00045 + Math.random() * 0.00035,
          driftAmp: 14 + Math.random() * 12,
        });
      }
    }

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      initDarkStars();
      initNebulae();
    }

    function drawDarkMode() {
      ctx.clearRect(0, 0, width, height);
      const cx = width / 2;
      const cy = height / 2;

      const offsetX = mouse.active ? (mouse.x - cx) * 0.04 : 0;
      const offsetY = mouse.active ? (mouse.y - cy) * 0.04 : 0;

      for (let i = 0; i < darkStars.length; i++) {
        const s = darkStars[i];
        s.z -= DARK_SPEED;

        if (s.z <= 0.02) {
          s.x = (Math.random() - 0.5) * width * 1.6;
          s.y = (Math.random() - 0.5) * height * 1.6;
          s.z = 1;
        }

        const perspective = 0.28 / s.z;
        const sx = cx + s.x * perspective - offsetX * (1 - s.z);
        const sy = cy + s.y * perspective - offsetY * (1 - s.z);

        if (sx < -20 || sx > width + 20 || sy < -20 || sy > height + 20) continue;

        const proximity = 1 - s.z;
        const radius = Math.max(0.4, s.size * proximity * 1.35);
        const alpha = Math.min(0.65, proximity * 0.75);

        const prevZ = s.z + DARK_SPEED * 2.2;
        const prevPerspective = 0.28 / prevZ;
        const px = cx + s.x * prevPerspective - offsetX * (1 - prevZ);
        const py = cy + s.y * prevPerspective - offsetY * (1 - prevZ);

        ctx.beginPath();
        ctx.moveTo(px, py);
        ctx.lineTo(sx, sy);
        ctx.strokeStyle = `rgba(244, 244, 245, ${alpha * 0.55})`;
        ctx.lineWidth = radius * 0.9;
        ctx.lineCap = 'round';
        ctx.stroke();

        ctx.beginPath();
        ctx.arc(sx, sy, radius, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(244, 244, 245, ${alpha})`;
        ctx.fill();
      }
    }

    function drawLightMode(now) {
      ctx.clearRect(0, 0, width, height);

      for (let i = 0; i < nebulae.length; i++) {
        const n = nebulae[i];
        const driftX = Math.cos(now * n.driftSpeed + n.driftPhase) * n.driftAmp;
        const driftY = Math.sin(now * n.driftSpeed * 0.85 + n.driftPhase) * n.driftAmp;

        let targetX = n.baseX + driftX;
        let targetY = n.baseY + driftY;

        if (mouse.active) {
          const dx = targetX - mouse.x;
          const dy = targetY - mouse.y;
          const dist = Math.hypot(dx, dy);

          if (dist < NEBULA_INFLUENCE_RADIUS && dist > 0.001) {
            const strength = Math.pow(1 - dist / NEBULA_INFLUENCE_RADIUS, 1.5);
            const push = strength * NEBULA_PUSH;
            targetX += (dx / dist) * push;
            targetY += (dy / dist) * push;
          }
        }

        n.x += (targetX - n.x) * NEBULA_EASE;
        n.y += (targetY - n.y) * NEBULA_EASE;

        const grad = ctx.createRadialGradient(n.x, n.y, n.radius * 0.05, n.x, n.y, n.radius);
        grad.addColorStop(0, `rgba(${n.rgb}, ${n.alpha})`);
        grad.addColorStop(0.55, `rgba(${n.rgb}, ${n.alpha * 0.42})`);
        grad.addColorStop(1, `rgba(${n.rgb}, 0)`);

        ctx.fillStyle = grad;
        ctx.beginPath();
        ctx.arc(n.x, n.y, n.radius, 0, Math.PI * 2);
        ctx.fill();
      }
    }

    function loop(now) {
      if (!document.hidden) {
        if (isDark) {
          drawDarkMode();
        } else {
          drawLightMode(now || 0);
        }
      }
      requestAnimationFrame(loop);
    }

    window.addEventListener('mousemove', (e) => {
      mouse.x = e.clientX;
      mouse.y = e.clientY;
      mouse.active = true;
    }, { passive: true });

    window.addEventListener('mouseleave', () => {
      mouse.active = false;
    });

    window.addEventListener('resize', resize, { passive: true });

    window.addEventListener('nebu-theme-change', () => {
      isDark = getCurrentIsDark();
    });

    darkQuery.addEventListener('change', () => {
      isDark = getCurrentIsDark();
    });

    resize();
    requestAnimationFrame(loop);
  })();
</script>

<style>
  .nebu-starfield {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    display: block;
  }
</style>