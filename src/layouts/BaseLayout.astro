---
import "../styles/tokens.css";
import "../styles/global.css";
import StarfieldBackground from "../components/StarfieldBackground.astro";

interface Props {
  title: string;
  enableBackgroundEffect?: boolean;
}

const { title, enableBackgroundEffect = true } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        try {
          const saved = localStorage.getItem('nebu-theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const theme = saved === 'light' || saved === 'dark' ? saved : (prefersDark ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
        } catch (_) {}
      })();
    </script>
  </head>
  <body>
    <StarfieldBackground enabled={enableBackgroundEffect} />

    <!-- Ukryty formularz statyczny rejestrowany przez Netlify Forms -->
    <form
      name="nebu-lead-capture"
      method="POST"
      action="/"
      data-netlify="true"
      netlify-honeypot="bot-field"
      hidden
    >
      <input type="hidden" name="form-name" value="nebu-lead-capture" />
      <input type="text" name="bot-field" />
      <input type="email" name="email" />
      <textarea name="question"></textarea>
      <textarea name="clickedTopics"></textarea>
    </form>

    <!-- Przycisk przełączania motywu w prawym górnym rogu -->
    <button
      type="button"
      class="theme-toggle"
      id="themeToggle"
      aria-label="Toggle color theme"
      title="Toggle light / dark mode"
    >
      <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
      </svg>
      <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
      </svg>
    </button>

    <div class="page-content" id="pageContent">
      <slot />
    </div>

    <script is:inline>
      const themeToggle = document.getElementById('themeToggle');
      const systemDarkQuery = window.matchMedia('(prefers-color-scheme: dark)');

      function applyTheme(theme, persist = false) {
        document.documentElement.setAttribute('data-theme', theme);
        if (persist) {
          try {
            localStorage.setItem('nebu-theme', theme);
          } catch (_) {}
        }
        window.dispatchEvent(new CustomEvent('nebu-theme-change', { detail: { theme } }));
      }

      if (themeToggle) {
        themeToggle.addEventListener('click', () => {
          const current = document.documentElement.getAttribute('data-theme') ||
            (systemDarkQuery.matches ? 'dark' : 'light');
          const next = current === 'dark' ? 'light' : 'dark';
          applyTheme(next, true);
        });
      }

      systemDarkQuery.addEventListener('change', (e) => {
        let saved = null;
        try {
          saved = localStorage.getItem('nebu-theme');
        } catch (_) {}
        if (!saved) {
          applyTheme(e.matches ? 'dark' : 'light', false);
        }
      });
    </script>
  </body>
</html>